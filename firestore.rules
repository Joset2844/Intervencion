rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /roles/{uid} {
      allow read, write: if false;
    }

    match /intervenciones/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.autorUid == request.auth.uid
                    && request.resource.data.maquina is string
                    && request.resource.data.falla is string;

      allow update, delete: if esAdmin();
    }
  }
}
